{
  "name": "number-reseller-app",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "db:generate": "corepack pnpm --filter @number-reseller/database prisma:generate",
    "db:migrate": "corepack pnpm --filter @number-reseller/database prisma:migrate",
    "db:seed": "corepack pnpm --filter @number-reseller/database seed"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@next/eslint-plugin-next": "15.1.4",
    "@types/node": "22.10.7",
    "eslint": "9.18.0",
    "pnpm": "9.15.4",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.8"
  }
}
