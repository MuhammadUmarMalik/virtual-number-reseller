REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
ENCRYPTION_KEY=replace-with-at-least-24-random-characters
JAZZCASH_CALLBACK_URL=http://localhost:4000/api/payments/jazzcash/callback
EASYPAISA_CALLBACK_URL=http://localhost:4000/api/payments/easypaisa/callback
VENDOR_BASE_URL=https://vendor.example.com
